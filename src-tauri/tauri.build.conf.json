{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "游戏体力计时器",
  "version": "0.2.0",
  "identifier": "com.stonebrooke.stamina-timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx tsc && npx vite build --outDir web-build",
    "frontendDist": "../web-build"
  },
  "app": {
    "windows": [
      {
        "title": "游戏体力计时器",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
