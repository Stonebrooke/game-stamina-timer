# ============================================================
# 游戏体力计时器 — .gitignore
# 仅保留「源码 + 配置 + 锁定文件」，其余一律忽略
# ============================================================

# ---------- 前端：依赖与构建产物 ----------
node_modules/
dist/
.vite/
*.local

# ---------- Rust / Tauri：编译产物 ----------
src-tauri/target/

# 沙箱冷编译用的独立 target 目录（非源码），需单独排除
src-tauri/target-test/

# ---------- Tauri 代码生成物（编译时重新生成，勿提交） ----------
src-tauri/gen/

# ---------- 运行时生成 / 本地备份（保险起见忽略） ----------
*.bak
*.tmp
*.log

# ---------- 锁定文件：必须提交，请勿加入忽略 ----------
# package-lock.json   <- 前端依赖锁，提交
# src-tauri/Cargo.lock <- Rust 二进制锁，提交

# ---------- 项目工具 / 沙箱内部数据（绝不可提交） ----------
.workbuddy/
# Brooks-Lint 工具链本地历史（PR #17 已关，但同类工具文件下次还会被带入）
.brooks-lint-history.json

# ---------- 上游/工具误提交产生的临时目录（PR #1 遗留，勿提交） ----------
.trae-html-share-packages/

# ---------- Python（scripts/ 下的脚本） ----------
__pycache__/
*.pyc
scripts/__pycache__/

# ---------- 环境变量 / 密钥 ----------
.env
.env.local

# ---------- 系统 & 编辑器 ----------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
